{
  "title": "Suspicious PowerShell Command Line (T1059.001)",
  "id": "7f3c2a10-5b1e-4c0a-9d1f-2a6b8c4e1001",
  "description": "Detects PowerShell started with encoded, hidden-window or download-cradle arguments, as produced by Atomic Red Team T1059.001 tests.",
