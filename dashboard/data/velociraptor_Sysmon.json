[{
  "title": "LSASS Dump Command Line (T1003.001)",
  "id": "7f3c2a10-5b1e-4c0a-9d1f-2a6b8c4e1005",
  "description": "Detects command lines used to dump LSASS memory (comsvcs.dll MiniDump, procdump, mimikatz). Still fires when Defender blocks the dump itself.",
  "sigmafile": "",
  "sigma": [
    "SELECT * FROM logs WHERE Channel='Microsoft-Windows-Sysmon/Operational' AND (EventID=1 AND ((CommandLine LIKE '%comsvcs%' ESCAPE '\\' AND CommandLine LIKE '%MiniDump%' ESCAPE '\\') OR (CommandLine LIKE '%procdump%' ESCAPE '\\' AND CommandLine LIKE '%lsass%' ESCAPE '\\') OR (CommandLine LIKE '%sekurlsa::%' ESCAPE '\\' OR CommandLine LIKE '%Invoke-Mimikatz%' ESCAPE '\\')))"
  ],
  "rule_level": "high",
  "tags": [
    "attack.credential_access",
    "attack.t1003.001"
  ],
  "count": 1
,
